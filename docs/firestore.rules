rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function hasEmail() {
      return isAuthenticated() && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Admin: users/<uid> con isAdmin == true, oppure admins/<email> (senza admin: false)
    function isAdmin() {
      return isAuthenticated() && (
        (hasEmail() && exists(/databases/$(database)/documents/admins/$(myEmail())) &&
         get(/databases/$(database)/documents/admins/$(myEmail())).data.get('admin', true) != false) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // 1. ADMINS: ognuno legge il proprio documento; il resto solo gli admin
    match /admins/{email} {
      allow get: if hasEmail() && myEmail() == email;
      allow read, write: if isAdmin();
    }

    // 2. USERS: il proprio profilo (users/<email> nella 2.0, users/<uid> prima); elenco solo agli admin
    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAuthenticated() && (request.auth.uid == userId || (hasEmail() && myEmail() == userId) || isAdmin());
    }

    // 3. NEWS, RACES, FANTA
    match /news/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /races/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /fanta/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 4. CHAT
    match /chat/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 5. COSTRUTTORI E PILOTI
    match /costruttori/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /piloti/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. SHARED: lettura per tutti; scrivono gli admin; chat, segnalazioni e feedback della 2.0 anche gli utenti
    match /shared/{doc} {
      allow read: if true;
      allow write: if isAdmin();
      allow write: if isAuthenticated() && doc in ['bt-chat-generale', 'bt-chat-live-gara', 'bt-chat-fantaf1-talk', 'bt-chat-boxradio', 'bt-chat-paddocktalk', 'bt-chat', 'bt-chat-reports'];
      allow create: if doc.matches('bt-feedback-.*') && (request.resource.data.user == 'anonimo' || (hasEmail() && request.resource.data.user == myEmail()));
      allow delete: if doc.matches('bt-feedback-.*') && hasEmail() && resource.data.user == myEmail();
    }
    match /shared/{doc}/{rest=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. RESETS
    match /resets/{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
